# Branding de NiranBox para Calamares.
# Esquema tomado del branding.desc de referencia del propio Calamares
# (github.com/calamares/calamares/tree/calamares/src/branding/default).
---
componentName: niranbox

welcomeStyleCalamares: false
welcomeExpandingLogo: true

windowExpanding: fullscreen
windowSize: 900px,600px
windowPlacement: center

sidebar: widget
navigation: widget

strings:
  productName: "NiranBox"
  shortProductName: "NiranBox"
  version: "1.0"
  shortVersion: "1.0"
  versionedName: "NiranBox 1.0"
  shortVersionedName: "NiranBox 1.0"
  bootloaderEntryName: "NiranBox"
  productUrl: "https://example.org/"
  supportUrl: "https://example.org/"
  knownIssuesUrl: "https://example.org/"
  releaseNotesUrl: "https://example.org/"
  donateUrl: "https://example.org/"

images:
  productIcon: "icon.png"
  productLogo: "logo.png"
  productWelcome: "welcome.png"

# Paleta oscura a juego con el splash de arranque (fondo negro, texto claro)
# y con el logo, que es un gris oscuro sobre blanco / blanco sobre negro.
style:
  SidebarBackground: "#111113"
  SidebarText: "#F2F2F2"
  SidebarTextCurrent: "#FFFFFF"
  SidebarBackgroundCurrent: "#3B82F6"

slideshow: [ "slideshow/1.png", "slideshow/2.png" ]

uploadServer:
  type: "none"
  url: ""
  sizeLimit: -1
