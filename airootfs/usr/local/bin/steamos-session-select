#!/usr/bin/env bash
# Emula el comando real de SteamOS: cambio RAPIDO de sesion, sin pasar por
# la pantalla de eleccion (niranbox-chooser.sh) -- esa solo se ve al prender
# la PC de cero. Deja escrito a cual sesion pasar y cierra la sesion actual;
# niranbox-chooser.sh lee ese archivo al entrar de nuevo y va directo, sin
# preguntar nada.
#
#   steamos-session-select plasma      -> pasa a Modo Escritorio (KDE Plasma)
#   steamos-session-select gamescope   -> vuelve a Modo Steam Deck (Steam)
#
# Steam llama esto solo cuando detecta el flag -steamos3 (ver
# start-gamescope-session.sh); si el boton "Cambiar a escritorio" de Steam no
# aparece, este comando funciona igual invocado desde una terminal, o puedes
# agregarlo como "juego no-Steam" en tu biblioteca para tener un icono.
set -eu

TARGET="${1:-}"
case "${TARGET}" in
    gamescope | gamescope-session)
        NEXT="gamescope"
        ;;
    plasma | plasma-persistent | desktop)
        NEXT="plasma"
        ;;
    *)
        echo "Uso: steamos-session-select {gamescope|plasma}" >&2
        exit 1
        ;;
esac

mkdir -p "${HOME}/.config/niranbox"
echo "${NEXT}" > "${HOME}/.config/niranbox/.next-session"

# Cierra la sesion grafica actual; SDDM vuelve a entrar sola (autologin
# sigue siendo niranbox-chooser.desktop), y el chooser ve el archivo de
# arriba y pasa directo a la sesion pedida, sin mostrar nada.
loginctl terminate-user "$(whoami)"
