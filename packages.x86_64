# --- Base del sistema (igual que el perfil releng de archiso) ---
base
linux
linux-firmware
mkinitcpio
mkinitcpio-archiso
grub
efibootmgr
plymouth
sudo
nano
vim
git
networkmanager
openssh

# --- Sistema de archivos / utilidades de instalacion ---
arch-install-scripts
btrfs-progs
dosfstools
e2fsprogs
exfatprogs
ntfs-3g
parted
gptfdisk

# --- Rendimiento / mantenimiento ---
# (recordatorio: nada de comentarios al final de la linea, rompen mkarchiso)
# zram-generator: swap comprimida en RAM, evita cuelgues si falta memoria.
# reflector: rankea mirrors de pacman por velocidad en el primer arranque.
zram-generator
reflector

# --- Audio ---
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
wireplumber

# --- Graficos: drivers Mesa (Intel/AMD, open source) + Vulkan ---
# Sin paquetes de NVIDIA: la PC de destino solo tiene GPU AMD/Intel.
mesa
lib32-mesa
vulkan-icd-loader
lib32-vulkan-icd-loader
vulkan-intel
lib32-vulkan-intel
vulkan-radeon
lib32-vulkan-radeon
xf86-video-amdgpu

# --- Ofimatica ---
# Apache OpenOffice no esta en los repos oficiales de Arch (solo existe como
# paquete no oficial en AUR, sin mantenimiento reciente). LibreOffice es el
# sucesor directo, mismo formato de archivos, y si esta en los repos
# oficiales, asi que va preinstalado en el ISO.
libreoffice-fresh
libreoffice-fresh-es

# --- Sesion de juego estilo SteamOS ---
gamescope
xorg-xwayland
steam
mangohud
lib32-mangohud
gamemode
lib32-gamemode

# --- Modo Escritorio (como el Steam Deck real), accesible desde Steam ---
sddm
plasma-desktop
plasma-nm
plasma-pa
xdg-desktop-portal
xdg-desktop-portal-kde
dolphin
konsole
kate
ark
spectacle
firefox
bluez
bluez-utils

# --- Compresion/descompresion (usados por Ark y el explorador de archivos) ---
unrar
unarchiver
p7zip
unzip
zip

# --- Oficina: lo que le faltaba al Modo Escritorio ---
# (packages.x86_64 solo admite comentarios en su propia linea, empezando con
# '#' -- un "paquete  # comentario" en la misma linea rompe el parseo de
# mkarchiso, que se queda con el espacio en blanco pegado al nombre)
okular
cups
print-manager
system-config-printer
gvfs
gvfs-mtp
gvfs-smb
xdg-user-dirs
ttf-liberation
noto-fonts
noto-fonts-emoji
hunspell
hunspell-es_any
hunspell-en_us

# --- Input (mandos) ---
# El kernel de Arch ya trae xpad/hid-sony/hid-microsoft integrados (mandos
# Xbox/PlayStation por cable o Bluetooth funcionan sin nada extra). El driver
# xpadneo (mejor soporte Bluetooth para mandos Xbox) esta en AUR, no en los
# repos oficiales, asi que no se puede meter en el ISO directamente: se
# instala despues, ya con el sistema arriba, con un ayudante de AUR (yay/paru).

# --- Instalador grafico propio (solo se usa en el USB live, para instalar
# en disco). Calamares habria sido lo ideal, pero no existe en los repos
# oficiales de Arch NI en Chaotic-AUR (se verifico directamente contra su
# base de datos), asi que se descarto por completo -- esto es 100% oficial.
xorg-server
xorg-xinit
xorg-xsetroot
yad

